---
/**
 * Konami — Easter egg. Listen for ↑↑↓↓←→←→BA and unlock the "Secret Keeper"
 * achievement + reveal a fun overlay message.
 */
---

<div class="konami-veil" id="konami-veil" aria-hidden="true" data-testid="konami-veil">
  <div class="konami-veil__inner">
    <span class="konami-veil__eyebrow">◆ SECRET LAYER UNCOVERED ◆</span>
    <h2>You found the developer's field notebook.</h2>
    <p>
      "Every dig has its jokes — this one was mine. Thanks for looking closer.
      — <em>Leslie</em>"
    </p>
    <button class="konami-veil__close" data-testid="konami-close">Close</button>
  </div>
</div>

<script>
  const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  let idx = 0;
  document.addEventListener('keydown', (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    if (key === seq[idx]) {
      idx += 1;
      if (idx === seq.length) {
        idx = 0;
        document.getElementById('konami-veil')?.classList.add('is-open');
        (window as any).lesarchAchieve?.('secret-keeper');
      }
    } else {
      idx = 0;
    }
  });
  document.getElementById('konami-veil')?.querySelector('.konami-veil__close')?.addEventListener('click', () => {
    document.getElementById('konami-veil')?.classList.remove('is-open');
  });
</script>

<style is:global>
  .konami-veil {
    position: fixed; inset: 0;
    background: radial-gradient(ellipse at center, rgba(184,90,58,0.15), rgba(21,17,13,0.98));
    backdrop-filter: blur(12px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 400;
    padding: 2rem;
  }
  .konami-veil.is-open { display: flex; animation: fadein .4s var(--ease); }
  .konami-veil__inner {
    max-width: 480px;
    text-align: center;
    color: var(--c-bone);
    padding: 3rem 2rem;
  }
  .konami-veil__eyebrow {
    font-family: var(--font-mono);
    font-size: .7rem;
    letter-spacing: .3em;
    color: var(--c-ochre);
    display: block;
    margin-bottom: 1.5rem;
  }
  .konami-veil h2 {
    color: var(--c-bone);
    font-size: var(--step-2);
    margin: 0 0 1rem;
  }
  .konami-veil p { color: rgba(250,245,233,0.8); font-style: italic; font-family: var(--font-display); font-size: 1.05rem; line-height: 1.5; max-width: none; }
  .konami-veil__close {
    margin-top: 2rem;
    background: var(--c-clay);
    color: #fff;
    border: 0;
    padding: .75rem 1.5rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    cursor: pointer;
  }
</style>
