---
/**
 * AchievementSystem — localStorage-based badge tracking.
 * Adds a global helper `window.lesarchAchieve(id)` that any script can call.
 * Renders unlock toasts in the bottom-left corner + a small "trophy" button
 * that opens a panel showing all achievements (locked & unlocked).
 */
import { ACHIEVEMENTS } from '../data/achievements';
---

<button class="ach-button" id="ach-button" aria-label="View achievements" data-testid="ach-button">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
    <path d="M4 22h16"/>
    <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
  </svg>
  <span class="ach-button__count" id="ach-count">0</span>
</button>

<div class="ach-panel" id="ach-panel" aria-hidden="true" data-testid="ach-panel">
  <div class="ach-panel__inner">
    <button class="ach-panel__close" aria-label="Close">×</button>
    <span class="eyebrow" style="margin-bottom:.5rem">Your discoveries</span>
    <h3 style="margin:0 0 1.25rem; font-size:1.5rem">Achievements</h3>
    <p style="font-size:.85rem; color:var(--ink-soft); margin-bottom:1.5rem">
      Progress is saved to your browser — no account needed.
    </p>
    <ul class="ach-list">
      {ACHIEVEMENTS.map((a) => (
        <li class="ach-item" data-ach-id={a.id}>
          <span class="ach-item__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={a.icon}></svg>
          </span>
          <div>
            <strong class="ach-item__name">{a.name}</strong>
            <p class="ach-item__desc">{a.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>

<div class="ach-toast-stack" id="ach-toast-stack" aria-live="polite"></div>

<script define:vars={{ ACHIEVEMENTS }}>
  /* eslint-disable no-undef -- vars injected by define:vars */
  const STORAGE_KEY = 'lesarch-achievements';
  const load = () => { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch (_) { return {}; } };
  const save = (state) => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (_) {} };

  const state = load();
  const updateUI = () => {
    const unlocked = Object.keys(state).filter((k) => state[k]?.unlocked).length;
    const count = document.getElementById('ach-count');
    if (count) count.textContent = String(unlocked);
    ACHIEVEMENTS.forEach((a) => {
      const el = document.querySelector(`[data-ach-id="${a.id}"]`);
      if (el) el.classList.toggle('is-unlocked', !!state[a.id]?.unlocked);
    });
  };

  const toast = (a) => {
    const stack = document.getElementById('ach-toast-stack');
    if (!stack) return;
    const el = document.createElement('div');
    el.className = 'ach-toast';
    el.setAttribute('role', 'status');
    el.innerHTML = `
      <span class="ach-toast__icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${a.icon}</svg>
      </span>
      <div>
        <span class="ach-toast__label">Achievement unlocked</span>
        <strong>${a.name}</strong>
        <p>${a.description}</p>
      </div>`;
    stack.appendChild(el);
    requestAnimationFrame(() => el.classList.add('is-in'));
    setTimeout(() => { el.classList.remove('is-in'); setTimeout(() => el.remove(), 400); }, 4200);
  };

  // Global API — any page script can call window.lesarchAchieve('id', payload?)
  window.lesarchAchieve = (id, payload = {}) => {
    const def = ACHIEVEMENTS.find((a) => a.id === id);
    if (!def) return;
    if (def.threshold) {
      // Count-based: payload.item is a unique key we track by
      state[id] = state[id] || { unlocked: false, items: [] };
      const key = payload.item || 'default';
      if (!state[id].items.includes(key)) {
        state[id].items.push(key);
        if (state[id].items.length >= def.threshold && !state[id].unlocked) {
          state[id].unlocked = true;
          save(state); updateUI(); toast(def);
          return;
        }
      }
      save(state); updateUI();
    } else {
      // Direct unlock
      if (!state[id]?.unlocked) {
        state[id] = { unlocked: true };
        save(state); updateUI(); toast(def);
      }
    }
  };

  // First-visit auto-unlock (only fires on true first load)
  if (!state['first-visit']?.unlocked) {
    setTimeout(() => window.lesarchAchieve('first-visit'), 1200);
  }

  // Panel open/close
  const btn = document.getElementById('ach-button');
  const panel = document.getElementById('ach-panel');
  btn?.addEventListener('click', () => panel?.classList.toggle('is-open'));
  panel?.querySelector('.ach-panel__close')?.addEventListener('click', () => panel.classList.remove('is-open'));
  panel?.addEventListener('click', (e) => { if (e.target === panel) panel.classList.remove('is-open'); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') panel?.classList.remove('is-open'); });

  updateUI();
</script>

<style is:global>
  .ach-button {
    position: fixed;
    bottom: 1.75rem; left: 1.75rem;
    width: 46px; height: 46px;
    background: var(--c-stone);
    color: var(--c-ochre);
    border: 1px solid var(--c-ochre);
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    z-index: 55;
    transition: transform .25s var(--ease);
  }
  .ach-button:hover { transform: scale(1.08); }
  .ach-button__count {
    position: absolute; top: -4px; right: -4px;
    background: var(--c-clay);
    color: #fff;
    font-family: var(--font-mono);
    font-size: .65rem;
    font-weight: 700;
    padding: 0 5px;
    min-width: 18px; height: 18px;
    line-height: 18px;
    border-radius: 999px;
    text-align: center;
    border: 2px solid var(--bg);
  }

  .ach-panel {
    position: fixed;
    inset: 0;
    background: rgba(21,17,13,0.75);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 2rem;
    animation: fadein .25s var(--ease);
  }
  .ach-panel.is-open { display: flex; }
  .ach-panel__inner {
    background: var(--c-bone);
    border-radius: var(--radius-lg);
    max-width: 560px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    position: relative;
    box-shadow: var(--shadow-strong);
  }
  .ach-panel__close {
    position: absolute; top: 1rem; right: 1rem;
    width: 36px; height: 36px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    color: var(--ink);
  }
  .ach-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .ach-item {
    display: flex; gap: 1rem; align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    opacity: 0.45;
    transition: opacity .3s var(--ease), border-color .3s var(--ease);
  }
  .ach-item.is-unlocked { opacity: 1; border-color: var(--c-ochre); }
  .ach-item__icon {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--bg-deep);
    color: var(--c-ash);
    flex-shrink: 0;
  }
  .ach-item.is-unlocked .ach-item__icon {
    background: var(--c-ochre); color: #fff;
  }
  .ach-item__name { display: block; margin-bottom: .15rem; }
  .ach-item__desc { margin: 0; font-size: .82rem; color: var(--ink-soft); }

  /* Toasts */
  .ach-toast-stack {
    position: fixed;
    bottom: 6rem; left: 1.75rem;
    display: flex; flex-direction: column;
    gap: .75rem;
    z-index: 300;
    pointer-events: none;
  }
  .ach-toast {
    display: flex; gap: .85rem;
    background: var(--c-stone);
    color: var(--c-bone);
    padding: 1rem 1.2rem;
    border-radius: var(--radius-lg);
    box-shadow: 0 14px 40px rgba(0,0,0,0.35);
    border-left: 4px solid var(--c-ochre);
    min-width: 280px;
    max-width: 340px;
    transform: translateX(-120%);
    transition: transform .5s var(--ease), opacity .3s var(--ease);
    pointer-events: auto;
  }
  .ach-toast.is-in { transform: translateX(0); }
  .ach-toast__icon {
    color: var(--c-ochre);
    padding-top: .25rem;
  }
  .ach-toast__label {
    display: block;
    font-family: var(--font-mono);
    font-size: .62rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--c-ochre);
    margin-bottom: .1rem;
  }
  .ach-toast strong { display: block; margin-bottom: .2rem; font-size: 1rem; }
  .ach-toast p { font-size: .78rem; color: rgba(250,245,233,0.7); margin: 0; }

  @media (max-width: 640px) {
    .ach-toast-stack { left: 1rem; right: 1rem; bottom: 5rem; }
    .ach-toast { max-width: none; }
  }
</style>
