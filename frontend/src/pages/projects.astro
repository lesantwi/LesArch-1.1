---
import Layout from '../layouts/Layout.astro';
import SiteCard from '../components/SiteCard.astro';
import { SITES } from '../data/sites';

const locale = 'en';
---

<Layout
  title="Projects — LesArch"
  description="All current and planned 3D archaeological reconstruction projects from LesArch."
  locale={locale}
  pathWithoutBase="/projects"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">The catalogue</span>
      <div class="section-header" style="margin-bottom:2rem">
        <h2 style="max-width:14ch">Projects, present and planned.</h2>
        <p class="lede">
          Every project on LesArch contributes to open archaeological research.
          Completed models are paired with a citable DOI; planned ones are
          documented for community contribution.
        </p>
      </div>

      <div class="card-grid">
        {SITES.map((site) => (
          <SiteCard site={site} locale={locale} detailHrefBase="/sites" />
        ))}
      </div>
    </div>
  </section>
</Layout>
