---
import Layout from '../layouts/Layout.astro';
import { SITES, ERAS, TRAILS, HISTORIC_MAPS } from '../data/sites';
import { t } from '../i18n/ui';

const locale = 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pre-compute era year extremes for timeline slider
const minYear = Math.min(...SITES.map((s) => s.yearStart));
const maxYear = Math.max(...SITES.map((s) => s.yearEnd));

const trails = TRAILS.map((tr) => ({
  ...tr,
  stops: SITES.filter((s) => s.country === tr.country)
    .sort((a, b) => a.yearStart - b.yearStart)
    .map((s) => ({
      slug: s.slug,
      name: s.name,
      coords: s.coords,
      eraLabel: s.eraLabel,
      note: s.shortDescription,
      year: s.yearStart,
      thumbnail: `${base}/${s.thumbnail.replace(/^\//, '')}`,
    })),
})).filter((tr) => tr.stops.length > 1);

const historicMaps = HISTORIC_MAPS.map((hm) => ({
  ...hm,
  image: `${base}/${hm.image.replace(/^\//, '')}`,
  attribution: `Historic map: <a href="${hm.credit.url}" target="_blank" rel="noopener">${hm.credit.text}</a> (${hm.credit.license})`,
}));
---

<Layout
  title="The Atlas — LesArch"
  description="An interactive map of archaeological wonders. Filter by era, status, and timeline."
  locale={locale}
  pathWithoutBase="/map"
>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
    />
    <style is:global>
      /* Warm the grey basemap so it sits with the earth-toned palette */
      #map .leaflet-tile-pane { filter: sepia(.2) saturate(.85) brightness(1.03); }
      .leaflet-popup-content-wrapper {
        background: var(--c-bone);
        color: var(--ink);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-strong);
        padding: 0;
      }
      .leaflet-popup-content { margin: 0; width: 280px !important; }
      .leaflet-popup-tip { background: var(--c-bone); }
      .marker-cluster div { background-color: rgba(184,90,58,0.9) !important; color: #fff !important; font-family: var(--font-mono); font-weight: 600; }
      .marker-cluster { background-color: rgba(184,90,58,0.3) !important; }
      .lesarch-popup img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
      .lesarch-popup__body { padding: 1rem 1.25rem 1.25rem; }
      .lesarch-popup__meta { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--c-clay); margin-bottom: .35rem; }
      .lesarch-popup h4 { font-size: 1.15rem; margin: 0 0 .4rem; }
      .lesarch-popup p { font-size: .85rem; color: var(--ink-soft); margin: 0 0 .85rem; }
      .lesarch-popup .btn { padding: .55rem 1rem; font-size: .8rem; }

      /* Map pin — teardrop shape with site-type icon inside */
      .map-pin {
        position: relative;
        width: 38px;
        height: 48px;
        cursor: pointer;
        transform-origin: 50% 100%;
        transition: transform .25s var(--ease), filter .25s var(--ease);
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.25)) drop-shadow(0 1px 2px rgba(0,0,0,0.15));
      }
      .map-pin:hover {
        transform: scale(1.15) translateY(-2px);
        filter: drop-shadow(0 8px 12px rgba(0,0,0,0.35)) drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        z-index: 1000;
      }
      .map-pin__body {
        position: absolute;
        inset: 0;
        color: var(--c-clay);     /* pin fill color, overridden by era class */
      }
      .map-pin__body svg { width: 100%; height: 100%; display: block; }
      .map-pin__icon {
        position: absolute;
        top: 7px;
        left: 50%;
        transform: translateX(-50%);
        width: 22px;
        height: 22px;
        color: #fff;
        display: flex; align-items: center; justify-content: center;
      }
      .map-pin__icon svg { width: 18px; height: 18px; }

      /* Era colors override the pin body fill */
      .map-pin.roman .map-pin__body              { color: #1F4A6B; }
      .map-pin.ancient-egypt .map-pin__body      { color: #C8923B; }
      .map-pin.medieval .map-pin__body           { color: #8C3F26; }
      .map-pin.classical-antiquity .map-pin__body { color: #6B5B95; }
      .map-pin.early-modern .map-pin__body       { color: #4A6B5A; }
      .map-pin.prehistoric .map-pin__body        { color: #594A3C; }

      /* "In-progress" pulse — gently calls attention to live projects */
      .map-pin.status-in-progress::before {
        content: '';
        position: absolute;
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        width: 38px; height: 38px;
        border-radius: 50%;
        background: currentColor;
        opacity: 0;
        animation: lesarch-pulse 2.4s var(--ease) infinite;
        color: var(--c-ochre);
        z-index: -1;
      }
      @keyframes lesarch-pulse {
        0%   { opacity: 0.55; transform: translate(-50%, -50%) scale(0.4); }
        100% { opacity: 0;    transform: translate(-50%, -50%) scale(2.1); }
      }
      @media (prefers-reduced-motion: reduce) {
        .map-pin.status-in-progress::before { animation: none; }
        .map-pin { transition: none; }
        .trail-line.is-active { animation: none; }
      }

      .map-pin.is-focus {
        transform: scale(1.3) translateY(-4px);
        filter: drop-shadow(0 0 6px rgba(200,146,59,0.9)) drop-shadow(0 10px 14px rgba(0,0,0,0.35));
      }

      /* Heritage trails */
      .trail-line { transition: stroke-width .3s var(--ease); }
      .trail-line.is-active { stroke-width: 4; animation: trail-march 1s linear infinite; }
      @keyframes trail-march { to { stroke-dashoffset: -24; } }
      .trail-control {
        margin-top: 1rem;
        padding: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: var(--c-bone);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
      }
      .trail-control__label {
        font-family: var(--font-mono);
        font-size: .72rem;
        letter-spacing: .15em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }
      .trail-control__hint { margin: .25rem 0 0; font-size: .9rem; color: var(--ink-soft); }
      .trail-control__buttons { display: flex; flex-wrap: wrap; gap: .5rem; }
      .trail-control__count { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .08em; opacity: .75; }
      .map-wrap { position: relative; margin-top: 1.5rem; isolation: isolate; }
      .trail-panel {
        position: absolute;
        left: 1rem;
        bottom: 1.5rem;
        z-index: 1000;
        width: min(360px, calc(100% - 2rem));
        padding: 1.25rem 1.25rem 1rem;
        background: color-mix(in oklab, var(--c-bone) 88%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-strong);
        opacity: 0;
        transform: translateY(16px);
        pointer-events: none;
        transition: opacity .35s var(--ease), transform .35s var(--ease);
      }
      .trail-panel.is-open { opacity: 1; transform: none; pointer-events: auto; }
      .trail-panel [hidden] { display: none !important; }
      .trail-panel__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .trail-panel__close {
        background: transparent; border: 0; cursor: pointer;
        font-size: 1.5rem; line-height: 1; color: var(--ink-soft);
        transition: color .2s var(--ease), transform .2s var(--ease);
      }
      .trail-panel__close:hover { color: var(--c-clay); transform: rotate(90deg); }
      .trail-panel__step {
        margin-top: .75rem;
        font-family: var(--font-mono); font-size: .68rem; letter-spacing: .15em;
        text-transform: uppercase; color: var(--c-clay);
      }
      .trail-panel h4 { margin: .25rem 0 .2rem; font-size: 1.3rem; }
      .trail-panel__era { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .06em; color: var(--ink-soft); }
      .trail-panel p { margin: .65rem 0 .9rem; font-size: .88rem; color: var(--ink-soft); }
      .trail-panel__bar { height: 3px; margin-bottom: .9rem; background: var(--line); border-radius: 3px; overflow: hidden; }
      .trail-panel__bar span { display: block; height: 100%; width: 0; background: var(--c-ochre); transition: width .5s var(--ease); }
      .trail-panel__actions { display: flex; flex-wrap: wrap; gap: .5rem; }
      .trail-panel__actions .btn { padding: .5rem .85rem; font-size: .78rem; }
      .trail-panel__actions .btn:disabled { opacity: .4; pointer-events: none; }
      .trail-panel__card img {
        display: block;
        width: 100%;
        aspect-ratio: 1200 / 630;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--bg-deep);
      }
      .trail-panel__share { display: flex; gap: .5rem; margin: .6rem 0 .9rem; }
      .trail-panel__share .btn { padding: .5rem .85rem; font-size: .78rem; }
      .history-control {
        margin-top: 1rem;
        padding: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 2rem;
        background: var(--c-bone);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
      }
      .history-control__text { flex: 1 1 380px; max-width: 70ch; }
      .history-control__credit { font-family: var(--font-mono); font-size: .68rem; color: var(--ink-soft); }
      .history-control__credit a { color: inherit; }
      .history-control__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; }
      .history-toggle[aria-pressed="true"] { --bg: var(--c-stone); --fg: #FAF5E9; border-color: var(--c-stone); color: #FAF5E9; }
      .history-fade {
        display: flex; align-items: center; gap: .6rem;
        font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft);
        transition: opacity .25s var(--ease);
      }
      .history-fade:has(input:disabled) { opacity: .45; }
      .history-fade input { width: 140px; accent-color: var(--c-clay); }
      .history-fade output { min-width: 3ch; color: var(--c-clay); }
      @media (max-width: 600px) {
        .trail-panel { left: .5rem; right: .5rem; bottom: 1.6rem; width: auto; }
      }
    </style>
  </Fragment>

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">The atlas</span>
      <h1 style="font-size:var(--step-3)">{t(locale, 'map.title')}</h1>
      <p class="lede">{t(locale, 'map.subtitle')}</p>

      <div class="map-controls" style="margin-top:2rem">
        <input
          type="search"
          id="map-search"
          placeholder={t(locale, 'map.search')}
          data-testid="map-search"
        />
        <select id="map-era-filter" data-testid="map-era-filter">
          <option value="all">{t(locale, 'map.filter.era')} — {t(locale, 'map.filter.all')}</option>
          {ERAS.map((era) => (
            <option value={era.value}>{era.label}</option>
          ))}
        </select>
        <select id="map-status-filter" data-testid="map-status-filter">
          <option value="all">{t(locale, 'map.filter.status')} — {t(locale, 'map.filter.all')}</option>
          <option value="completed">{t(locale, 'status.completed')}</option>
          <option value="in-progress">{t(locale, 'status.in-progress')}</option>
          <option value="planned">{t(locale, 'status.planned')}</option>
        </select>
      </div>

      <div class="timeline-control">
        <label for="map-timeline">
          {t(locale, 'map.timeline')}: showing sites up to
          <output id="map-timeline-output">{maxYear} AD</output>
          <button type="button" class="timeline-play" id="map-timeline-play" data-testid="map-timeline-play" aria-label="Play time-lapse">
            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Play time-lapse
          </button>
        </label>
        <input
          type="range"
          id="map-timeline"
          min={minYear}
          max={maxYear}
          value={maxYear}
          step="1"
          data-testid="map-timeline"
        />
        <div style="display:flex; justify-content:space-between; margin-top:.4rem; font-family:var(--font-mono); font-size:.7rem; color:var(--ink-soft); letter-spacing:.08em;">
          <span>{Math.abs(minYear)} {minYear < 0 ? 'BCE' : 'AD'}</span>
          <span>{maxYear} AD</span>
        </div>
      </div>

      {trails.length > 0 && (
        <div class="trail-control" data-testid="trail-control">
          <div>
            <span class="trail-control__label">Heritage trails</span>
            <p class="trail-control__hint">Guided routes that fly you from site to site, in date order.</p>
          </div>
          <div class="trail-control__buttons">
            {trails.map((tr) => (
              <button type="button" class="btn btn--lapis trail-start" data-trail={tr.id} data-testid={`trail-start-${tr.id}`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h7.5a3.5 3.5 0 0 0 0-7h-7a3.5 3.5 0 0 1 0-7H16"/></svg>
                Follow the {tr.name}
                <span class="trail-control__count">{tr.stops.length} stops</span>
              </button>
            ))}
          </div>
        </div>
      )}

      {historicMaps.map((hm) => (
        <div class="history-control" data-testid="history-control">
          <div class="history-control__text">
            <span class="trail-control__label">Historic maps</span>
            <p class="trail-control__hint"><strong>{hm.title}.</strong> {hm.note}</p>
            <small class="history-control__credit" data-testid={`history-credit-${hm.id}`}>
              <a href={hm.credit.url} target="_blank" rel="noopener">{hm.credit.text}</a> · {hm.credit.license}, via Wikimedia Commons
            </small>
          </div>
          <div class="history-control__actions">
            <button type="button" class="btn btn--ghost history-toggle" data-map={hm.id} aria-pressed="false" data-testid={`history-toggle-${hm.id}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
              <span class="history-toggle__text">Show {hm.year} map</span>
            </button>
            <label class="history-fade">
              <span>Fade</span>
              <input type="range" min="10" max="100" value="75" class="history-fade__input" data-map={hm.id} disabled data-testid={`history-fade-${hm.id}`} aria-label={`Fade the ${hm.year} map`} />
              <output data-testid={`history-fade-value-${hm.id}`}>75%</output>
            </label>
          </div>
        </div>
      ))}

      <div class="map-wrap">
        <div id="map" data-testid="map-canvas"></div>
        <aside class="trail-panel" id="trail-panel" data-testid="trail-panel" aria-hidden="true" aria-live="polite">
          <div class="trail-panel__head">
            <span class="eyebrow" id="trail-name" data-testid="trail-name"></span>
            <button type="button" class="trail-panel__close" id="trail-close" data-testid="trail-close" aria-label="End trail">×</button>
          </div>
          <div class="trail-panel__step" id="trail-step" data-testid="trail-step"></div>
          <h4 id="trail-stop-name" data-testid="trail-stop-name"></h4>
          <div class="trail-panel__era" id="trail-stop-era" data-testid="trail-stop-era"></div>
          <p id="trail-stop-note" data-testid="trail-stop-note"></p>
          <div class="trail-panel__card" id="trail-card" data-testid="trail-card" hidden>
            <img id="trail-card-img" data-testid="trail-card-img" alt="Your heritage trail card" />
            <div class="trail-panel__share">
              <button type="button" class="btn btn--ghost" id="trail-save" data-testid="trail-save">Save picture</button>
              <button type="button" class="btn btn--lapis" id="trail-share" data-testid="trail-share">Share</button>
            </div>
          </div>
          <div class="trail-panel__bar"><span id="trail-progress"></span></div>
          <div class="trail-panel__actions">
            <button type="button" class="btn btn--ghost" id="trail-prev" data-testid="trail-prev">← Back</button>
            <a class="btn btn--ghost" id="trail-view" data-testid="trail-view-site" href="#">View site</a>
            <button type="button" class="btn btn--primary" id="trail-next" data-testid="trail-next">Next →</button>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script
    is:inline
    src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
  ></script>

  <script define:vars={{ sites: SITES, base, trails, historicMaps }}>
    // @ts-nocheck
    const map = L.map('map', { worldCopyJump: true, maxZoom: 16 }).setView([20, 10], 2);

    // Esri Light Gray Canvas — keyless; base layer plus a separate labels layer
    const ESRI = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas';
    L.tileLayer(`${ESRI}/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}`, {
      attribution: 'Tiles &copy; <a href="https://www.esri.com/">Esri</a> &mdash; Esri, HERE, Garmin, &copy; OpenStreetMap contributors',
      maxZoom: 16,
    }).addTo(map);
    L.tileLayer(`${ESRI}/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}`, {
      maxZoom: 16,
      pane: 'overlayPane',
    }).addTo(map);

    const eraInitial = {
      roman: 'R',
      'ancient-egypt': 'E',
      medieval: 'M',
      'classical-antiquity': 'C',
      'early-modern': 'F',
      prehistoric: 'P',
    };

    // The teardrop pin background — single shape, color set via CSS `currentColor`
    const PIN_BODY = `
      <svg viewBox="0 0 38 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          d="M19 0C8.5 0 0 8.5 0 19c0 13.7 17.1 27.6 18.1 28.4a1.5 1.5 0 0 0 1.8 0C20.9 46.6 38 32.7 38 19 38 8.5 29.5 0 19 0Z"
          fill="currentColor" stroke="#fff" stroke-width="1.5"/>
      </svg>`;

    // Site-type → SVG icon dictionary. Each icon is white-on-color inside the pin.
    // Designed at 24x24, single-color via `currentColor`, stroke 1.8 round caps.
    const TYPE_ICON = {
      'Aqueduct Bridge': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18"/><path d="M3 19V7m18 12V7"/><path d="M7 19v-5a2 2 0 0 1 4 0v5"/><path d="M13 19v-5a2 2 0 0 1 4 0v5"/><path d="M3 19h18"/></svg>`,
      'Buddhist Temple': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 6 6h12L12 2Z"/><path d="M7 10h10l-1 3H8l-1-3Z"/><path d="M8 16h8l-1 3H9l-1-3Z"/><path d="M11 22h2"/></svg>`,
      'Mosque': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V11"/><path d="M20 20V11"/><path d="M4 20h16"/><path d="M8 20v-5a4 4 0 0 1 8 0v5"/><path d="M12 6V2"/><path d="M10 4h4"/></svg>`,
      'Rock-Cut Monument': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20V8l7-4 7 4v12"/><path d="M9 20v-6h6v6"/><path d="M3 20h18"/></svg>`,
      'Pyramid': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 20h18L12 3Z"/><path d="M12 3v17"/></svg>`,
      'Amphitheatre': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="13" rx="9" ry="6"/><path d="M3 13h18M7 8v10M12 7v12M17 8v10"/></svg>`,
      'Citadel': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20 8 9l4 6 3-4 6 9Z"/><path d="M3 20h18"/></svg>`,
      'Colonial Fort': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V10h2V7h2v3h2V7h2v3h2V7h2v3h2v11"/><path d="M10 21v-4a2 2 0 0 1 4 0v4"/></svg>`,
    };
    const DEFAULT_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 22s-7-7-7-12a7 7 0 0 1 14 0c0 5-7 12-7 12Z"/></svg>`;

    function makeIcon(site) {
      const icon = TYPE_ICON[site.type] || DEFAULT_ICON;
      return L.divIcon({
        className: '',
        iconSize: [38, 48],
        iconAnchor: [19, 47],    // tip of the teardrop = exact site coord
        popupAnchor: [0, -42],   // popup appears above the pin
        html: `
          <div class="map-pin ${site.era} status-${site.status}" title="${site.name} — ${site.eraLabel}">
            <div class="map-pin__body">${PIN_BODY}</div>
            <div class="map-pin__icon">${icon}</div>
          </div>`,
      });
    }

    function popupHtml(site) {
      const img = `${base}/${site.thumbnail.replace(/^\//, '')}`;
      const href = `${base}/sites/${site.slug}`;
      return `<div class="lesarch-popup">
        <img src="${img}" alt="${site.name}" loading="lazy" />
        <div class="lesarch-popup__body">
          <div class="lesarch-popup__meta">${site.country} · ${site.eraLabel}</div>
          <h4>${site.name}</h4>
          <p>${site.shortDescription}</p>
          <a class="btn btn--primary" href="${href}">View details →</a>
        </div>
      </div>`;
    }

    const cluster = L.markerClusterGroup({
      spiderfyOnMaxZoom: true,
      showCoverageOnHover: false,
      maxClusterRadius: 50,
    });

    let allMarkers = sites.map((site) => {
      const m = L.marker(site.coords, { icon: makeIcon(site) });
      m.bindPopup(popupHtml(site), { closeButton: true, maxWidth: 320 });
      m.siteData = site;
      return m;
    });

    function applyFilters() {
      const q = document.getElementById('map-search').value.trim().toLowerCase();
      const era = document.getElementById('map-era-filter').value;
      const status = document.getElementById('map-status-filter').value;
      const yearMax = parseInt(document.getElementById('map-timeline').value, 10);
      document.getElementById('map-timeline-output').textContent =
        yearMax < 0 ? `${Math.abs(yearMax)} BCE` : `${yearMax} AD`;

      cluster.clearLayers();
      const filtered = allMarkers.filter((m) => {
        const s = m.siteData;
        if (q && !(s.name.toLowerCase().includes(q) || s.country.toLowerCase().includes(q) || s.eraLabel.toLowerCase().includes(q))) return false;
        if (era !== 'all' && s.era !== era) return false;
        if (status !== 'all' && s.status !== status) return false;
        if (s.yearStart > yearMax) return false;
        return true;
      });
      filtered.forEach((m) => cluster.addLayer(m));
      map.addLayer(cluster);
    }

    document.getElementById('map-search').addEventListener('input', applyFilters);
    document.getElementById('map-era-filter').addEventListener('change', applyFilters);
    document.getElementById('map-status-filter').addEventListener('change', applyFilters);
    document.getElementById('map-timeline').addEventListener('input', applyFilters);

    applyFilters();

    // Track achievement — user has visited the map
    window.lesarchAchieve?.('cartographer');

    // ---- Time-lapse mode ----
    const playBtn = document.getElementById('map-timeline-play');
    const timelineInput = document.getElementById('map-timeline');
    const timelineMin = parseInt(timelineInput.min, 10);
    const timelineMax = parseInt(timelineInput.max, 10);
    let playing = false;
    let rafId = null;
    let startTs = 0;
    const DURATION = 22000; // 22s to scrub full range

    function stopPlayback() {
      playing = false;
      if (rafId) cancelAnimationFrame(rafId);
      rafId = null;
      playBtn.classList.remove('is-playing');
      playBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>Play time-lapse';
    }

    function tick(ts) {
      if (!startTs) startTs = ts;
      const elapsed = ts - startTs;
      const progress = Math.min(1, elapsed / DURATION);
      const eased = 1 - Math.pow(1 - progress, 2); // ease-out
      const year = Math.round(timelineMin + (timelineMax - timelineMin) * eased);
      timelineInput.value = year;
      applyFilters();
      if (progress < 1 && playing) rafId = requestAnimationFrame(tick);
      else stopPlayback();
    }

    playBtn.addEventListener('click', () => {
      if (playing) { stopPlayback(); return; }
      // Rewind to start
      timelineInput.value = timelineMin;
      applyFilters();
      playing = true;
      startTs = 0;
      playBtn.classList.add('is-playing');
      playBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>Stop';
      rafId = requestAnimationFrame(tick);
      window.lesarchAchieve?.('chronomancer');
    });

    // Track region visit (approximate — mark region when a site's popup opens)
    map.on('popupopen', (e) => {
      const marker = allMarkers.find((m) => m.getPopup() === e.popup);
      if (marker?.siteData?.region) {
        window.lesarchAchieve?.('world-traveller', { item: marker.siteData.region });
      }
    });

    // ---- Heritage trails: dotted route + guided "follow the trail" tour ----
    const trailLines = {};
    trails.forEach((tr) => {
      trailLines[tr.id] = L.polyline(tr.stops.map((s) => s.coords), {
        color: '#C8923B',
        weight: 3,
        opacity: 0.9,
        dashArray: '2 10',
        lineCap: 'round',
        className: 'trail-line',
        interactive: false,
      }).addTo(map);
    });

    const panel = document.getElementById('trail-panel');
    const $ = (id) => document.getElementById(id);
    let tour = null;

    function focusPin(slug) {
      allMarkers.forEach((m) => {
        m.getElement()?.querySelector('.map-pin')?.classList.toggle('is-focus', m.siteData.slug === slug);
      });
    }

    function renderTour() {
      const { trail, i } = tour;
      const total = trail.stops.length;
      $('trail-name').textContent = trail.name;
      $('trail-progress').style.width = `${Math.min(100, ((i + 1) / total) * 100)}%`;
      $('trail-card').hidden = i < total;
      if (i >= total) {
        $('trail-step').textContent = 'Trail complete ✓';
        $('trail-stop-name').textContent = `You followed the ${trail.name}`;
        $('trail-stop-era').textContent = '';
        $('trail-stop-note').textContent = 'Trailblazer badge unlocked — save your trail card or share it.';
        $('trail-view').hidden = true;
        $('trail-prev').disabled = false;
        $('trail-next').textContent = 'Close';
        $('trail-share').textContent = navigator.share ? 'Share' : 'Copy link';
        focusPin(null);
        map.flyToBounds(trailLines[trail.id].getBounds(), { padding: [90, 90], maxZoom: 7, duration: 1.6 });
        makeTrailCard(trail).then((card) => {
          if (tour && tour.i >= total) $('trail-card-img').src = card.url;
        });
        return;
      }
      if (i < 0) {
        $('trail-step').textContent = `${total} stops`;
        $('trail-stop-name').textContent = trail.stops.map((s) => s.name).join(' → ');
        $('trail-stop-era').textContent = '';
        $('trail-stop-note').textContent = trail.intro;
        $('trail-view').hidden = true;
        $('trail-prev').disabled = true;
        $('trail-next').textContent = 'Start the trail →';
        focusPin(null);
        map.flyToBounds(trailLines[trail.id].getBounds(), { padding: [90, 90], maxZoom: 7, duration: 1.6 });
        return;
      }
      const stop = trail.stops[i];
      $('trail-step').textContent = `Stop ${i + 1} of ${total}`;
      $('trail-stop-name').textContent = stop.name;
      $('trail-stop-era').textContent = stop.eraLabel;
      $('trail-stop-note').textContent = stop.note;
      $('trail-view').hidden = false;
      $('trail-view').href = `${base}/sites/${stop.slug}`;
      $('trail-prev').disabled = false;
      $('trail-next').textContent = i === total - 1 ? 'Finish trail ✓' : 'Next stop →';
      // On phones the panel covers the lower map, so aim the pin into the upper half
      let target = L.latLng(stop.coords);
      if (window.innerWidth <= 600) {
        target = map.unproject(map.project(target, 11).add([0, panel.offsetHeight / 2]), 11);
      }
      map.flyTo(target, 11, { duration: 2.2 });
      map.once('moveend', () => setTimeout(() => focusPin(stop.slug), 350));
    }

    function startTour(id) {
      const trail = trails.find((tr) => tr.id === id);
      if (!trail) return;
      if (playing) stopPlayback();
      // Clear filters so every stop on the trail is visible
      $('map-search').value = '';
      $('map-era-filter').value = 'all';
      $('map-status-filter').value = 'all';
      timelineInput.value = timelineMax;
      applyFilters();
      map.closePopup();
      if (tour) trailLines[tour.trail.id].getElement()?.classList.remove('is-active');
      tour = { trail, i: -1 };
      trailLines[id].getElement()?.classList.add('is-active');
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      $('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
      renderTour();
    }

    function endTour() {
      if (!tour) return;
      const line = trailLines[tour.trail.id];
      line.getElement()?.classList.remove('is-active');
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      focusPin(null);
      tour = null;
      map.flyToBounds(line.getBounds(), { padding: [90, 90], maxZoom: 7, duration: 1.4 });
    }

    document.querySelectorAll('.trail-start').forEach((btn) => {
      btn.addEventListener('click', () => startTour(btn.dataset.trail));
    });
    $('trail-next').addEventListener('click', () => {
      if (!tour) return;
      const total = tour.trail.stops.length;
      if (tour.i >= total) { endTour(); return; }
      if (tour.i === total - 1) window.lesarchAchieve?.('trailblazer');
      tour.i += 1;
      renderTour();
    });

    // ---- Shareable trail card (drawn on a canvas, same-origin images only) ----
    const cardCache = {};
    const loadImg = (src) => new Promise((resolve) => {
      const im = new Image();
      im.onload = () => resolve(im);
      im.onerror = () => resolve(null);
      im.src = src;
    });
    const fmtYear = (y) => (y < 0 ? `${-y} BCE` : `${y} AD`);

    function wrapText(g, text, x, y, maxW, lineH) {
      let line = '';
      text.split(' ').forEach((word) => {
        const test = line ? `${line} ${word}` : word;
        if (g.measureText(test).width > maxW && line) {
          g.fillText(line, x, y);
          line = word;
          y += lineH;
        } else line = test;
      });
      g.fillText(line, x, y);
      return y;
    }

    async function makeTrailCard(trail) {
      if (cardCache[trail.id]) return cardCache[trail.id];
      await Promise.all(
        ['600 60px Fraunces', '600 20px "Public Sans"', '500 16px "JetBrains Mono"'].map((f) => document.fonts.load(f).catch(() => null))
      );
      const photos = await Promise.all(trail.stops.map((s) => loadImg(s.thumbnail)));
      const W = 1200, H = 630;
      const c = document.createElement('canvas');
      c.width = W; c.height = H;
      const g = c.getContext('2d');
      const MONO = '"JetBrains Mono", monospace', SERIF = 'Fraunces, Georgia, serif', SANS = '"Public Sans", sans-serif';

      g.fillStyle = '#F2EADB'; g.fillRect(0, 0, W, H);
      ['#D9C7A1', '#C8923B', '#B85A3A', '#2A241D'].forEach((col, k) => { g.fillStyle = col; g.fillRect(0, H - 56 + k * 14, W, 14); });

      // Left column: title, stops, badge
      if ('letterSpacing' in g) g.letterSpacing = '3px';
      g.fillStyle = '#B85A3A'; g.font = `500 15px ${MONO}`;
      g.fillText('LESARCH · HERITAGE TRAIL COMPLETED', 72, 92);
      if ('letterSpacing' in g) g.letterSpacing = '0px';
      g.fillStyle = '#2A241D'; g.font = `600 58px ${SERIF}`;
      let y = wrapText(g, trail.name, 72, 160, 560, 64);
      const first = trail.stops[0].year, last = trail.stops[trail.stops.length - 1].year;
      g.fillStyle = '#6B6258'; g.font = `500 21px ${SANS}`;
      g.fillText(`${trail.stops.length} stops · ${fmtYear(first)} → ${fmtYear(last)}`, 72, y + 44);
      y += 104;
      trail.stops.slice(0, 4).forEach((s, k) => {
        g.fillStyle = '#B85A3A'; g.beginPath(); g.arc(90, y - 8, 17, 0, Math.PI * 2); g.fill();
        g.fillStyle = '#fff'; g.font = `600 17px ${SANS}`; g.textAlign = 'center'; g.fillText(String(k + 1), 90, y - 2); g.textAlign = 'left';
        g.fillStyle = '#2A241D'; g.font = `600 28px ${SERIF}`; g.fillText(s.name, 124, y);
        g.fillStyle = '#6B6258'; g.font = `400 14px ${MONO}`; g.fillText(s.eraLabel, 124, y + 24);
        y += 70;
      });
      // Trailblazer badge pill
      const bx = 72, by = H - 120;
      g.fillStyle = '#2A241D'; g.beginPath(); g.roundRect(bx, by, 236, 46, 23); g.fill();
      g.strokeStyle = '#C8923B'; g.lineWidth = 2.4; g.lineCap = 'round';
      g.beginPath(); g.arc(bx + 24, by + 30, 5, 0, Math.PI * 2); g.stroke();
      g.beginPath(); g.arc(bx + 44, by + 16, 5, 0, Math.PI * 2); g.stroke();
      g.beginPath(); g.moveTo(bx + 29, by + 30); g.lineTo(bx + 36, by + 30); g.quadraticCurveTo(bx + 46, by + 26, bx + 36, by + 21); g.lineTo(bx + 30, by + 20); g.stroke();
      if ('letterSpacing' in g) g.letterSpacing = '3px';
      g.fillStyle = '#C8923B'; g.font = `600 15px ${MONO}`; g.fillText('TRAILBLAZER', bx + 66, by + 29);
      if ('letterSpacing' in g) g.letterSpacing = '0px';
      g.fillStyle = '#6B6258'; g.font = `500 15px ${MONO}`; g.textAlign = 'right';
      g.fillText(`${location.host}${base}`, W - 60, H - 82); g.textAlign = 'left';

      // Right column: mini route map with stop photos
      const box = { x: 690, y: 56, w: 450, h: 450 };
      g.fillStyle = '#E8DCC4'; g.beginPath(); g.roundRect(box.x, box.y, box.w, box.h, 24); g.fill();
      g.save(); g.beginPath(); g.roundRect(box.x, box.y, box.w, box.h, 24); g.clip();
      g.strokeStyle = 'rgba(42,36,29,0.08)'; g.lineWidth = 1.5;
      for (let r = 60; r < 420; r += 38) { g.beginPath(); g.ellipse(box.x + 300, box.y + 260, r * 1.3, r, -0.4, 0, Math.PI * 2); g.stroke(); }
      g.restore();
      const lats = trail.stops.map((s) => s.coords[0]), lngs = trail.stops.map((s) => s.coords[1]);
      const pad = 95, span = Math.max(Math.max(...lats) - Math.min(...lats), Math.max(...lngs) - Math.min(...lngs)) || 1;
      const k = (Math.min(box.w, box.h) - pad * 2) / span;
      const midLat = (Math.max(...lats) + Math.min(...lats)) / 2, midLng = (Math.max(...lngs) + Math.min(...lngs)) / 2;
      const pts = trail.stops.map((s) => [box.x + box.w / 2 + (s.coords[1] - midLng) * k, box.y + box.h / 2 - (s.coords[0] - midLat) * k]);
      g.strokeStyle = '#C8923B'; g.lineWidth = 6; g.setLineDash([2, 16]);
      g.beginPath(); pts.forEach(([px, py], n) => (n ? g.lineTo(px, py) : g.moveTo(px, py))); g.stroke(); g.setLineDash([]);
      pts.forEach(([px, py], n) => {
        const R = 56;
        g.save(); g.beginPath(); g.arc(px, py, R, 0, Math.PI * 2); g.clip();
        const im = photos[n];
        if (im) {
          const sc = Math.max((R * 2) / im.width, (R * 2) / im.height);
          g.drawImage(im, px - (im.width * sc) / 2, py - (im.height * sc) / 2, im.width * sc, im.height * sc);
        } else { g.fillStyle = '#D9C7A1'; g.fillRect(px - R, py - R, R * 2, R * 2); }
        g.restore();
        g.strokeStyle = '#FAF5E9'; g.lineWidth = 6; g.beginPath(); g.arc(px, py, R, 0, Math.PI * 2); g.stroke();
        g.fillStyle = '#B85A3A'; g.beginPath(); g.arc(px + R * 0.72, py - R * 0.72, 17, 0, Math.PI * 2); g.fill();
        g.fillStyle = '#fff'; g.font = `600 16px ${SANS}`; g.textAlign = 'center'; g.fillText(String(n + 1), px + R * 0.72, py - R * 0.72 + 6);
        g.fillStyle = '#2A241D'; g.font = `600 18px ${SANS}`; g.fillText(trail.stops[n].name, px, py + R + 28); g.textAlign = 'left';
      });

      const blob = await new Promise((resolve) => c.toBlob(resolve, 'image/png'));
      cardCache[trail.id] = { blob, url: URL.createObjectURL(blob), filename: `lesarch-${trail.id}-trail.png` };
      return cardCache[trail.id];
    }

    $('trail-save').addEventListener('click', async () => {
      if (!tour) return;
      const card = await makeTrailCard(tour.trail);
      const a = document.createElement('a');
      a.href = card.url;
      a.download = card.filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
    });
    $('trail-share').addEventListener('click', async () => {
      if (!tour) return;
      const btn = $('trail-share');
      const card = await makeTrailCard(tour.trail);
      const url = `${location.origin}${base}/map`;
      const text = `I followed the ${tour.trail.name} on LesArch`;
      const file = new File([card.blob], card.filename, { type: 'image/png' });
      try {
        if (navigator.canShare?.({ files: [file] })) await navigator.share({ files: [file], title: tour.trail.name, text, url });
        else if (navigator.share) await navigator.share({ title: tour.trail.name, text, url });
        else {
          await navigator.clipboard.writeText(`${text} — ${url}`);
          btn.textContent = 'Link copied ✓';
          setTimeout(() => (btn.textContent = 'Copy link'), 1800);
        }
      } catch (err) {
        // Share sheet dismissed by the visitor — nothing to do
      }
    });

    // ---- Historic map overlays (blended into the basemap, fade adjustable) ----
    map.createPane('historic');
    const histPane = map.getPane('historic');
    histPane.style.zIndex = 350;
    histPane.style.mixBlendMode = 'multiply';
    const histLayers = {};
    document.querySelectorAll('.history-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hm = historicMaps.find((h) => h.id === btn.dataset.map);
        const fade = document.querySelector(`.history-fade__input[data-map="${hm.id}"]`);
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        btn.querySelector('.history-toggle__text').textContent = `${on ? 'Hide' : 'Show'} ${hm.year} map`;
        fade.disabled = !on;
        if (!on) { histLayers[hm.id]?.remove(); return; }
        if (!histLayers[hm.id]) {
          histLayers[hm.id] = L.imageOverlay(hm.image, hm.bounds, {
            pane: 'historic',
            opacity: fade.value / 100,
            attribution: hm.attribution,
            className: 'historic-overlay',
          });
        }
        histLayers[hm.id].addTo(map);
        const b = L.latLngBounds(hm.bounds);
        map.flyTo(b.getCenter(), map.getBoundsZoom(b) + 1, { duration: 1.6 });
      });
    });
    document.querySelectorAll('.history-fade__input').forEach((input) => {
      input.addEventListener('input', () => {
        input.nextElementSibling.textContent = `${input.value}%`;
        histLayers[input.dataset.map]?.setOpacity(input.value / 100);
      });
    });
    $('trail-prev').addEventListener('click', () => {
      if (!tour || tour.i < 0) return;
      tour.i -= 1;
      renderTour();
    });
    $('trail-close').addEventListener('click', endTour);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') endTour();
    });
  </script>
</Layout>
